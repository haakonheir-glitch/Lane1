/**
 * Generates src/lib/taxonomy/generated.ts from the shape of taxonomy/taxonomy.json.
 *
 *   npm run taxonomy:types            write the file
 *   npm run taxonomy:types -- --check exit 1 if the file is out of date (used by tests/CI)
 *
 * Object shapes (Family, Lane, Role, Ladder, …) are inferred from every instance in the JSON:
 * a key missing from some instances becomes optional. String fields whose values come from one
 * of the taxonomy's vocabularies (levels, modes, payoffs, …) become literal unions, so a typo in
 * a component is a type error and a rebuilt taxonomy with a new value changes the types.
 */
import { readFileSync, writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

const root = fileURLToPath(new URL("..", import.meta.url));
const OUT = `${root}src/lib/taxonomy/generated.ts`;
const tax = JSON.parse(readFileSync(`${root}taxonomy/taxonomy.json`, "utf8"));

const lanes = tax.families.flatMap((f: { lanes: unknown[] }) => f.lanes) as Record<string, unknown>[];
const roles = lanes.flatMap((l) => l.roles as Record<string, unknown>[]);
const ladders = Object.values(tax.ladders) as Record<string, unknown>[];

const lit = (vs: Iterable<string>) => [...new Set(vs)].sort().map((v) => JSON.stringify(v)).join(" | ");

/** Vocabularies: name → allowed values, taken from the data itself. */
const vocab: Record<string, string[]> = {
  LevelId: Object.keys(tax.levels),
  TrackId: Object.values(tax.levels as Record<string, { track: string }>).map((l) => l.track),
  ModeId: tax.modes,
  PayoffId: Object.keys(tax.payoffs),
  EntryId: Object.keys(tax.entry),
  SprintId: Object.keys(tax.sprint),
  TagId: Object.keys(tax.tags),
  LadderId: Object.keys(tax.ladders),
  FamilyId: tax.families.map((f: { id: string }) => f.id),
  LaneId: lanes.map((l) => l.id as string),
  LaneStatus: lanes.map((l) => l.status as string),
};

/** Which vocabulary a field holds, per object type (field → union name). */
const fieldVocab: Record<string, Record<string, string>> = {
  Family: { id: "FamilyId" },
  Lane: { id: "LaneId", family: "FamilyId", payoff: "PayoffId", entry: "EntryId", sprint: "SprintId", modes: "ModeId", ladder: "LadderId", tags: "TagId", status: "LaneStatus" },
  Role: { level: "LevelId", track: "TrackId", mode: "ModeId", tags: "TagId" },
};
/** Nested object fields that are themselves named types. */
const nested: Record<string, Record<string, string>> = {
  Family: { lanes: "Lane[]" },
  Lane: { roles: "Role[]" },
};

function tsOf(value: unknown): string {
  if (Array.isArray(value)) {
    if (value.length === 0) return "string[]";
    if (value.every((v) => Array.isArray(v))) return `${tupleOf(value as unknown[][])}[]`;
    return `${tsOf(value[0])}[]`;
  }
  if (value === null) return "null";
  if (typeof value === "object") {
    const vals = Object.values(value as object);
    return vals.length && vals.every((v) => typeof v === "string") ? "Record<string, string>" : "Record<string, unknown>";
  }
  return typeof value;
}
function tupleOf(rows: unknown[][]): string {
  const len = rows[0]!.length;
  return `[${Array.from({ length: len }, (_, i) => tsOf(rows[0]![i])).join(", ")}]`;
}

function shape(name: string, instances: Record<string, unknown>[]): string {
  const keys = [...new Set(instances.flatMap((o) => Object.keys(o)))];
  const lines = keys.map((k) => {
    const optional = instances.some((o) => !(k in o)) ? "?" : "";
    const sample = instances.find((o) => k in o)![k];
    let t = nested[name]?.[k] ?? tsOf(sample);
    const v = fieldVocab[name]?.[k];
    if (v) t = Array.isArray(sample) ? `${v}[]` : v;
    return `  ${k}${optional}: ${t};`;
  });
  return `export interface ${name} {\n${lines.join("\n")}\n}`;
}

// Ladder steps are [level, label] pairs.
const ladderShape = shape("Ladder", ladders).replace("steps: [string, string][];", "steps: [LevelId, string][];");

const out = `// GENERATED by scripts/gen-taxonomy-types.mts from taxonomy/taxonomy.json. Do not edit.
// Taxonomy ${tax.meta.version}: ${tax.meta.counts.families} families, ${tax.meta.counts.lanes} lanes, ${tax.meta.counts.roles} roles.

${Object.entries(vocab)
  .map(([n, vs]) => `export type ${n} = ${lit(vs)};`)
  .join("\n")}

${shape("Family", tax.families)}

${shape("Lane", lanes)}

${shape("Role", roles)}

${ladderShape}

export interface Taxonomy {
  meta: { name: string; version: string; counts: Record<string, number>; structure: string };
  levels: Record<LevelId, { track: TrackId; label: string; typical_years: string }>;
  modes: ModeId[];
  payoffs: Record<PayoffId, string>;
  entry: Record<EntryId, string>;
  sprint: Record<SprintId, string>;
  tags: Record<TagId, string>;
  tag_to_constructs: Record<TagId, string[]>;
  ladders: Record<LadderId, Ladder>;
  families: Family[];
}
`;

if (process.argv.includes("--check")) {
  const current = (() => {
    try {
      return readFileSync(OUT, "utf8");
    } catch {
      return "";
    }
  })();
  if (current !== out) {
    console.error("src/lib/taxonomy/generated.ts is out of date. Run: npm run taxonomy:types");
    process.exit(1);
  }
  console.log("Taxonomy types are up to date.");
} else {
  writeFileSync(OUT, out);
  console.log(`Wrote ${OUT}`);
}

export { out as generatedSource };
