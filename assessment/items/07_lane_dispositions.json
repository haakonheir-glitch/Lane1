    {
      "id": "DSP_competitiveness_3",
      "scale": "Competitiveness",
      "scale_code": "competitiveness",
      "key": 1,
      "text": "Get more motivated when I have a rival."
    },
    {
      "id": "DSP_visibility_comfort_3",
      "scale": "Comfort with visibility and audiences",
      "scale_code": "visibility_comfort",
      "key": 1,
      "text": "Like being recognized by people I don't know."
    },
    {
      "id": "DSP_self_direction_3",
      "scale": "Self-direction (low need for external structure)",
      "scale_code": "self_direction",
      "key": 1,
      "text": "Start projects without anyone asking me to."
