    {
      "id": "DSP_long_horizon_2",
      "scale": "Long-horizon motivation",
      "scale_code": "long_horizon",
      "key": 1,
      "text": "Can stick with a plan whose payoff is far away."
    },
    {
      "id": "DSP_physical_embodied_2",
      "scale": "Physical and hands-on orientation",
      "scale_code": "physical_embodied",
      "key": 1,
      "text": "Prefer working with my hands to working at a screen."
    },
    {
      "id": "DSP_persuasion_2",
      "scale": "Persuasion and selling orientation",
      "scale_code": "persuasion",
      "key": 1,
      "text": "Am comfortable asking strangers for something."
    },
    {
      "id": "DSP_variance_tolerance_3",
      "scale": "Variance tolerance (career and income uncertainty)",
      "scale_code": "variance_tolerance",
      "key": 1,
      "text": "Am drawn to bets where I could lose a lot but win much more."
