    "est_minutes": 14
  },
  "scoring": {
    "reverse": "If key == -1, score = 6 - response.",
    "facet": "Mean of the 4 keyed responses (1-5). Require >= 3 of 4 answered; else facet = null.",
    "domain": "Mean of all keyed responses in the domain (Openness uses O1-O5 only).",
    "norming": "Convert to T-scores against Lane's own norm sample once N >= 1,000 per age band; until then use published IPIP-NEO-120 norms as provisional and label results 'provisional norms'.",
