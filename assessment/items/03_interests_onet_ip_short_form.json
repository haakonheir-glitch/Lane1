{
  "module": "interests_riasec",
  "instrument": "O*NET Interest Profiler Short Form (60 work activities)",
  "citation": "National Center for O*NET Development. O*NET Interest Profiler Short Form. U.S. Department of Labor, Employment and Training Administration. https://www.onetcenter.org/IP.html",
  "license": {
    "summary": "Two options. Verbatim copy: CC BY-ND 4.0. Any modification or extension (including changing the response format from the paper checkbox to a 5-point scale): O*NET Tools Developer License, which requires credit, a link to the license page, and validation of the product. https://www.onetcenter.org/license_tools.html",
    "required_attribution": "This page includes information from the O*NET Career Exploration Tools by the U.S. Department of Labor, Employment and Training Administration (USDOL/ETA). Used under the O*NET Tools Developer License. O*NET® is a trademark of USDOL/ETA. Lane has modified all or some of this information. USDOL/ETA has not approved, endorsed, or tested these modifications.",
    "trademark_rule": "Use 'O*NET' only as an adjective ('O*NET Interest Profiler'), never as a noun, verb, plural or possessive. Show the ® symbol.",
    "action": "Register as a developer: https://www.onetcenter.org/register"
  },
  "response_format": {
    "type": "likert5",
    "stem": "How much would you like doing this activity? Don't think about the education or training needed, or how much money you would make.",
    "options": [
      {
        "value": 1,
        "label": "Strongly dislike"
      },
      {
        "value": 2,
        "label": "Dislike"
      },
      {
        "value": 3,
        "label": "Unsure"
      },
      {
        "value": 4,
        "label": "Like"
      },
      {
        "value": 5,
        "label": "Strongly like"
      }
    ]
  },
  "administration": {
    "order": "As listed (R-I-A-S-E-C interleaved). Randomize within each block of 6 if desired.",
    "est_minutes": 7
  },
  "scoring": {
    "scale_raw": "Sum of 10 responses per scale (range 10-50). Also store the count of 'Like'+'Strongly like' (0-10), which maps to the official checkbox scoring and the O*NET occupation-matching tables.",
    "profile": "Holland code = the 3 highest scales. Also compute differentiation (highest minus lowest scale) and elevation (mean of all six). Low differentiation = interests not yet formed; flag it rather than forcing a code.",
    "occupation_match": "Correlate the user's 6-scale profile with O*NET occupational interest profiles (O*NET database 'Interests' file, CC BY 4.0) for ~900 occupations."
  },
